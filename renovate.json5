{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Runs on GitHub Actions against github.com/batleforc/weebo-si (.github/
  // workflows/renovate.yml); platform/token/repository live there, not here.
  // Base branch is the repo default, develop.
  //
  // Renovate is the only version automation in this repo. Updatecli was kept
  // for one coordinated bump (kubeblock, whose crd_version and version had to
  // move together); that chart was removed on 2026-08-30 and Updatecli with it.
  //
  // Nothing here is autodiscovered: the upstream charts are pinned as arbitrary
  // keys in values.yaml that Helm-templated ArgoCD Applications interpolate into
  // targetRevision, which defeats both the built-in argocd manager and Updatecli's
  // helm crawler. Every pin carries a `# renovate:` comment -- a new one is
  // invisible without it.

  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    'helpers:pinGitHubActionDigests',
  ],

  timezone: 'Europe/Paris',
  labels: ['Upgrade', 'Renovate'],

  // No `schedule` here on purpose. The workflow cron is the only timing gate;
  // an internal schedule on top of it means a manual workflow_dispatch outside
  // the window half-works -- Renovate commits the branch but does not open the
  // PR -- which is exactly what happened on the first run.

  // The charts here are pinned in ArgoCD Applications that sync automatically,
  // so a merged PR is a production deploy. Nothing self-merges; a few days of
  // soak also filters out charts that get yanked or re-tagged shortly after
  // release.
  automerge: false,

  // The built-in GITHUB_TOKEN cannot read Dependabot alerts -- the Actions
  // `permissions:` block has no scope for them -- so Renovate logs "Cannot
  // access vulnerability alerts" on every run. OSV needs no permission at all
  // and covers the language deps (0.docs npm, the two pulumi go.mod) where
  // advisories actually exist; Helm charts and images are out of scope for both.
  osvVulnerabilityAlerts: true,
  minimumReleaseAge: '3 days',
  prConcurrentLimit: 10,
  prHourlyLimit: 4,

  // The built-in kubernetes manager ships with no file pattern at all -- plain
  // Kubernetes YAML is too ambiguous to match blind -- so it finds nothing
  // until pointed somewhere. 2.terra holds ArgoCD PostSync hook Jobs applied as
  // raw manifests rather than through a chart, which is why their images were
  // invisible to both the customManager below (it only reads `version:` keys in
  // values.yaml) and helm-values. They ran `hashicorp/terraform:latest` against
  // real Vault and Authentik state until 2026-09-05.
  kubernetes: {
    managerFilePatterns: ['2.terra/**/*.yaml'],
  },

  ignorePaths: [
    '**/node_modules/**',
    '.tmp/**',
    // Vendored subchart of the ClickStack fork -- it is a build output of
    // `helm dependency update`, not a thing to bump in place.
    '2.helm/clickstack/charts/**',
  ],

  customManagers: [
    {
      customType: 'regex',
      description: 'Upstream chart/image versions pinned as plain values keys and consumed by ArgoCD Application templates (targetRevision) or image templates',
      managerFilePatterns: [
        '2.argo/helm/**/values.yaml',
        '2.helm/**/values.yaml',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+?)(?:\\s+registryUrl=(?<registryUrl>\\S+?))?(?:\\s+versioning=(?<versioning>\\S+?))?\\s*\\n\\s*version:\\s*["\']?(?<currentValue>[^"\'\\s]+)',
      ],
      // Empty template => fall back to each datasource's own default versioning.
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{/if}}',
    },
  ],

  packageRules: [
    {
      description: 'Chart and image majors are a decision, not a chore: open them from the dashboard checkbox. 2.terra is here because those Jobs run `terraform apply` against live Vault and Authentik state -- a major terraform bump is a state-format decision, not a chore.',
      matchFileNames: ['2.argo/**', '2.helm/**', '2.terra/**'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
    },
    {
      description: 'ClickHouse server and keeper speak the same inter-node protocol and are meant to move together. Group them so a bump is never half-applied -- the keeper floated on :latest until 2026-09-05 precisely because only the server was pinned.',
      matchDepNames: ['clickhouse/clickhouse-server', 'clickhouse/clickhouse-keeper'],
      groupName: 'clickhouse',
    },
    {
      description: 'ClickHouse version is load-bearing for the ClickStack dashboard SQL -- tiles are validated against 25.8 and silently fail on other majors',
      matchDepNames: ['clickhouse/clickhouse-server', 'clickhouse/clickhouse-keeper'],
      matchUpdateTypes: ['major', 'minor'],
      dependencyDashboardApproval: true,
      addLabels: ['revalidate-dashboards'],
    },
    {
      description: 'ClickStack is a fork: a Chart.yaml dependency bump also needs `helm dependency update` re-vendoring by hand',
      matchFileNames: ['2.helm/clickstack/Chart.yaml'],
      dependencyDashboardApproval: true,
      addLabels: ['needs-revendor'],
    },
    {
      description: 'Docs site: one PR for the whole lockfile',
      matchFileNames: ['0.docs/**'],
      groupName: 'docs site',
    },
    {
      description: 'Pulumi programs share a dependency set',
      matchManagers: ['gomod'],
      groupName: 'pulumi go modules',
    },
    {
      matchManagers: ['terraform'],
      groupName: 'terraform providers',
    },
    {
      matchManagers: ['github-actions'],
      groupName: 'forgejo actions',
    },
  ],
}
